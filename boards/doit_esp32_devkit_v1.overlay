/ {
	aliases {
		i2s-tx1 = &i2s0;
		i2s-tx2= &i2s1;

        left-sensor=&left_sensor;
        right-sensor=&right_sensor;
        volume-sensor=&volume_sensor;
	};
};


&i2c0 {
	sda-gpios = <&gpio0 17 GPIO_OPEN_DRAIN>;
    scl-gpios = <&gpio0 16 GPIO_OPEN_DRAIN>;

    left_sensor: left_st_vl53l0x@32{
        compatible = "st,vl53l0x";
        status = "okay";
        reg = < 0x32 >;
        xshut-gpios = < &gpio0 26 (GPIO_ACTIVE_LOW)>;
    };
    right_sensor: right_st_vl53l0@33{
        compatible = "st,vl53l0x";
        status = "okay";
        reg = < 0x33 >;
        xshut-gpios = < &gpio0 27 (GPIO_ACTIVE_LOW)>;
    };

    volume_sensor: volume_st_vl53l0@34{
        compatible = "st,vl53l0x";
        status = "okay";
        reg = < 0x34 >;
        xshut-gpios = < &gpio0 25 (GPIO_ACTIVE_LOW)>;
    };
};

&i2s0_default {
	group1 {
		pinmux = <I2S0_O_BCK_GPIO4>,
			 <I2S0_O_SD_GPIO2>,
			 <I2S0_O_WS_GPIO15>;
	};
};

&i2s0 {
	status = "okay";
	interrupts = <I2S0_INTR_SOURCE IRQ_DEFAULT_PRIORITY 0>;
	interrupt-names = "tx";
};

&i2s1 {
	status = "okay";
	pinctrl-0 = <&i2s1_default>;
    pinctrl-names = "default";
	interrupts = <I2S1_INTR_SOURCE IRQ_DEFAULT_PRIORITY 0>;
	interrupt-names = "tx";
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO17>,
				 <I2C0_SCL_GPIO16>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};

    i2s1_default: i2s1_default {
		group1 {
			pinmux = <I2S1_O_BCK_GPIO21>,
				<I2S1_O_SD_GPIO22>,
				<I2S1_O_WS_GPIO23>;
		};
	};
};